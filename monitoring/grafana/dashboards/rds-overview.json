{
  "annotations": {
    "list": []
  },
  "description": "RDS PostgreSQL 모니터링 대시보드",
  "editable": true,
  "panels": [
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Total Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"cdpdb\"} / (pg_stat_database_blks_hit{datname=\"cdpdb\"} + pg_stat_database_blks_read{datname=\"cdpdb\"} + 1)",
          "legendFormat": "Hit Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "title": "Database Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"cdpdb\"}",
          "legendFormat": "cdpdb"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Connections Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "pg_stat_activity_count{state=\"idle\"}",
          "legendFormat": "Idle"
        },
        {
          "expr": "pg_stat_activity_count{state=\"idle in transaction\"}",
          "legendFormat": "Idle in TX"
        }
      ]
    },
    {
      "title": "Transactions per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"cdpdb\"}[5m])",
          "legendFormat": "Commits/s"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"cdpdb\"}[5m])",
          "legendFormat": "Rollbacks/s"
        }
      ]
    },
    {
      "title": "Tuple Operations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_user_tables_n_tup_ins[5m]))",
          "legendFormat": "Inserts/s"
        },
        {
          "expr": "sum(rate(pg_stat_user_tables_n_tup_upd[5m]))",
          "legendFormat": "Updates/s"
        },
        {
          "expr": "sum(rate(pg_stat_user_tables_n_tup_del[5m]))",
          "legendFormat": "Deletes/s"
        }
      ]
    },
    {
      "title": "Dead Tuples (Bloat)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "topk(10, pg_stat_user_tables_n_dead_tup)",
          "legendFormat": "{{ relname }}"
        }
      ]
    },
    {
      "title": "Lock Waits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "pg_locks_count{mode=~\".*Exclusive.*\"}",
          "legendFormat": "{{ mode }}"
        }
      ]
    },
    {
      "title": "Replication Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "pg_replication_lag",
          "legendFormat": "Lag (seconds)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["rds", "postgresql", "database"],
  "time": { "from": "now-3h", "to": "now" },
  "title": "RDS PostgreSQL Overview",
  "uid": "cdp-rds-overview"
}
